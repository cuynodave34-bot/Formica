{
  "name": "formica",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "jest --runInBand",
    "verify": "npm run typecheck && npm run lint && npm test && npm run format && npm run expo:check && npm run audit:moderate && node scripts/verify-phase-0-1.mjs",
    "doctor": "npx --yes expo-doctor@1.19.8",
    "audit:moderate": "npm audit --audit-level=moderate",
    "expo:check": "expo install --check",
    "eas:version": "npx --yes eas-cli@19.0.8 --version",
    "docker:check": "node scripts/check-docker.mjs",
    "supabase:start": "npx --yes supabase@2.101.0 start --exclude realtime",
    "supabase:start:full": "npx --yes supabase@2.101.0 start",
    "supabase:status": "npx --yes supabase@2.101.0 status",
    "supabase:db:start": "npx --yes supabase@2.101.0 db start",
    "supabase:db:lint": "npx --yes supabase@2.101.0 db lint --local",
    "supabase:reset": "npx --yes supabase@2.101.0 db reset"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@supabase/supabase-js": "^2.106.1",
    "expo": "~54.0.23",
    "expo-constants": "~18.0.13",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "prettier": "^3.8.3",
    "react-test-renderer": "^19.1.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "postcss": "^8.5.15",
    "xcode": {
      "uuid": "^11.1.1"
    }
  },
  "private": true,
  "jest": {
    "preset": "jest-expo"
  }
}
